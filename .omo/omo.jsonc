// Team routing for OMO Native v5. Provider definitions live in agent/models.json.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[native]": {
    "model_profile": "company",
    "model_profiles": {
      "company": {
        "models": [
          {
            "model": "llmconnector/llmproxy/moonshotai/kimi-k3.1-pro",
